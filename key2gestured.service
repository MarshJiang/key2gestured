[Unit]
Description=KEY2 Gesture Daemon
Documentation=https://github.com/MarshJiang/key2gestured
Wants=keyd.service systemd-udev-settle.service
After=keyd.service systemd-udev-settle.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/key2gestured
ExecStart=/usr/local/bin/key2gestured
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60

# Must run as root to access /dev/input event devices and /dev/uinput.
User=root

# Security hardening — NOT using ProtectSystem=strict or
# ProtectKernelTunables=yes, because uinput UI_DEV_CREATE
# needs write access to sysfs to register the device.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
